# -*- mode: toml -*-

[backdrop]
enabled = true

[control_center]
sidebar = "full"

[location]
auto_locate = true

[lockscreen]
blurred_desktop = true
blur_intensity = 0.9
tint_intensity = 0.5

[shell]
avatar_path = "{{ .chezmoi.homeDir }}/.face"
telemetry_enabled = false

[shell.panel]
transparency_mode = "glass"

[theme]
mode = "auto"
source = "wallpaper"

[theme.templates]
builtin_ids = [ "foot", "gtk3", "gtk4", "qt", "umbriel" ]
community_ids = [ "papirus-icons" ]

[theme.templates.user.emacs]
input_path = "$XDG_CONFIG_HOME/noctalia/templates/emacs.el"
output_path = "$XDG_CONFIG_HOME/emacs/etc/themes/noctalia-theme.el"
post_hook = "emacsclient -e \"(load-theme 'noctalia t)\""

[wallpaper]
directory = "~/Pictures/Wallpapers"
per_monitor_directories = true

[wallpaper.automation]
enabled = true
interval_seconds = 3600

[include]
files = [
  "hosts/{{ .chezmoi.hostname }}.toml",
]
