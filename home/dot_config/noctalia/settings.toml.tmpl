# -*- mode: toml -*-

[backdrop]
enabled = true

[control_center]
sidebar = "full"

[location]
auto_locate = true

[lockscreen]
blurred_desktop = true
blur_intensity = 0.9
tint_intensity = 0.5

[shell]
avatar_path = "{{ .chezmoi.homeDir }}/.face"
polkit_agent = true
telemetry_enabled = false

[shell.panel]
transparency_mode = "glass"

[theme]
mode = "auto"
pure_black_dark = true
source = "wallpaper"


[wallpaper]
directory = "~/Pictures/Wallpapers"

[include]
files = [
  "templates.toml",
  "hosts/{{ .chezmoi.hostname }}.toml",
]
